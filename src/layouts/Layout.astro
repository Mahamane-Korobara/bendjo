---
import '../styles/global.css';
const { title = 'BenDjo — Infusions naturelles 100% Made in Bénin' } = Astro.props;
---

<!doctype html>
<html lang="fr">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <meta name="description" content="BenDjo — infusions naturelles 100% made in Bénin : hibiscus, citronnelle, basilic. Purifier, digérer, se détendre. La marque qui vous reconnecte à vos origines." />
        <link rel="icon" type="image/webp" href="/images/bendjo/logo-mark.webp" />
        <title>{title}</title>

        <!-- Polices : Fraunces (titres) + Inter (corps) — chargement non bloquant + display=swap -->
        <link rel="preconnect" href="https://fonts.bunny.net" crossorigin />
        <link
            rel="stylesheet"
            href="https://fonts.bunny.net/css?family=fraunces:600,700|inter:400,600,700&display=swap"
            media="print"
            onload="this.media='all'"
        />
        <noscript>
            <link
                rel="stylesheet"
                href="https://fonts.bunny.net/css?family=fraunces:600,700|inter:400,600,700&display=swap"
            />
        </noscript>
    </head>
    <body>
        <slot />
    </body>
</html>
