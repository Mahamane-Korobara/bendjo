---
import '../styles/global.css';
import CartDrawer from '../components/CartDrawer.astro';
import Footer from '../components/Footer.astro';

export interface Props {
    title?: string;
    description?: string;
}

const {
    title = 'BenDjo — Infusions naturelles 100% Made in Bénin',
    description = 'BenDjo, marque béninoise basée à Cotonou : infusions naturelles hibiscus, citronnelle et basilic, petit-déjeuner en entreprise et service traiteur. 100% made in Bénin, sans additif.',
} = Astro.props;

// `site` est défini dans astro.config.mjs : plus d'URL de repli en dur ici.
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL('/images/bendjo/og-cover.webp', Astro.site);
---

<!doctype html>
<html lang="fr">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <meta name="description" content={description} />
        <link rel="canonical" href={canonical.href} />
        <!-- Monogramme BenDjo. Le .ico couvre le /favicon.ico que les navigateurs
             réclament d'office ; le WebP n'était pas lu partout. -->
        <link rel="icon" href="/favicon.ico" sizes="32x32" />
        <link rel="icon" type="image/png" href="/icon-512.png" sizes="512x512" />
        <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
        <title>{title}</title>

        <meta property="og:type" content="website" />
        <meta property="og:site_name" content="BenDjo" />
        <meta property="og:title" content={title} />
        <meta property="og:description" content={description} />
        <meta property="og:locale" content="fr_BJ" />
        <meta property="og:url" content={canonical.href} />
        <!-- Sans og:image, WhatsApp — le canal principal de BenDjo — affichait
             les liens partagés sans aucun visuel. -->
        <meta property="og:image" content={ogImage.href} />
        <meta property="og:image:width" content="1200" />
        <meta property="og:image:height" content="630" />
        <meta property="og:image:alt" content="BenDjo — les trois infusions du terroir béninois" />
        <meta name="twitter:card" content="summary_large_image" />

        <!-- Polices : Fraunces (titres) + Inter (corps) — chargement non bloquant + display=swap -->
        <link rel="preconnect" href="https://fonts.bunny.net" crossorigin />
        <link
            rel="stylesheet"
            href="https://fonts.bunny.net/css?family=fraunces:600,700|inter:400,600,700&display=swap"
            media="print"
            onload="this.media='all'"
        />
        <noscript>
            <link
                rel="stylesheet"
                href="https://fonts.bunny.net/css?family=fraunces:600,700|inter:400,600,700&display=swap"
            />
        </noscript>
    </head>
    <body>
        <!-- Sans lui, un visiteur au clavier traverse le logo, 5 liens de nav,
             le panier et le CTA avant d'atteindre le contenu, sur chaque page. -->
        <a class="skip" href="#contenu">Aller au contenu</a>
        <slot />
        <Footer />
        <CartDrawer />
    </body>
</html>
