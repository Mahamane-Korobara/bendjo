---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Reassurance from '../components/Reassurance.astro';

import { products, packPrice, formatFCFA, WHATSAPP_BASE as WA } from '../data/products';

const ritual = [
    { h: '07:00', id: 'hibiscus', name: 'Hibiscus', text: 'À jeun ou au petit-déjeuner, pour démarrer avec une infusion écarlate riche en antioxydants.' },
    { h: '13:30', id: 'citronnelle', name: 'Citronnelle', text: 'Juste après le déjeuner, pour alléger la digestion et éviter le coup de barre.' },
    { h: '21:00', id: 'basilic', name: 'Basilic', text: 'Une demi-heure avant le coucher, pour faire redescendre la tension du jour.' },
];
---

<Layout title="Nos infusions — BenDjo">
    <Header />

    <main class="inf">
        <!-- ==================== INTRO ==================== -->
        <section class="inf-hero">
            <div class="srvx-head">
                <div>
                    <p class="srvx-eyebrow">/ Le catalogue</p>
                    <h1 class="srvx-title">
                        Trois plantes,<br />
                        <span class="srvx-title-em">trois rituels</span>
                    </h1>
                </div>
                <div class="srvx-aside">
                    <p>
                        Une infusion, c’est l’essence d’une plante libérée par l’eau chaude.
                        Rien d’autre. Nos trois plantes sont récoltées au Bénin et séchées
                        lentement à l’ombre — sans additif, sans colorant, sans arôme ajouté.
                    </p>
                    <div class="srvx-links">
                        <a href="/nos-infusions" data-cart-open>Composer mon panier <span aria-hidden="true">›</span></a>
                        <a href="/contact">Nous écrire <span aria-hidden="true">›</span></a>
                    </div>
                </div>
            </div>

            <nav class="inf-jump" aria-label="Aller à une infusion">
                {products.map((p) => (
                    <a class={`jump jump-${p.id}`} href={`#${p.id}`}>
                        <img src={p.photo} alt="" width="500" height="500" loading="lazy" />
                        <span><b>{p.name}</b>{p.moment}</span>
                    </a>
                ))}
            </nav>
        </section>

        <!-- ==================== UNE BANDE PAR PLANTE ==================== -->
        {products.map((p, i) => (
            <section class={`plant plant-${p.id} ${i % 2 === 1 ? 'is-reverse' : ''}`} id={p.id}>
                <div class="plant-inner">
                    <div class="plant-media">
                        <span class="plant-num" aria-hidden="true">{p.num}</span>
                        <img class="plant-photo" src={p.photo} alt={`Infusion ${p.name} BenDjo`} width="500" height="500" loading="lazy" />
                    </div>

                    <div class="plant-body">
                        <p class="plant-kicker">
                            <span class="plant-index">N°{p.num}</span>
                            <span class="plant-tag">{p.tag}</span>
                        </p>
                        <p class="plant-latin">{p.latin}</p>
                        <h2 class="plant-name">{p.name}</h2>
                        <p class="plant-tagline">{p.tagline}</p>
                        <p class="plant-format">{p.format}</p>
                        <p class="plant-note">{p.note}</p>

                        <ul class="plant-benefits">
                            {p.benefits.map((b) => (
                                <li>
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m5 12 4.5 4.5L19 7"></path></svg>
                                    {b}
                                </li>
                            ))}
                        </ul>

                        <dl class="plant-brew">
                            {p.brew.map((b) => (
                                <div>
                                    <dt>{b.v}</dt>
                                    <dd>{b.l}</dd>
                                </div>
                            ))}
                        </dl>

                        <div class="plant-buy">
                            <span class="plant-price">{formatFCFA(p.price)} <small>FCFA</small></span>
                            <button class="btn-add" type="button" data-add={p.id} data-name={p.name}>
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M12 5v14"></path></svg>
                                Ajouter au panier
                            </button>
                        </div>

                        {p.caution && (
                            <p class="plant-caution">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"></circle><path d="M12 16v-5M12 8h.01"></path></svg>
                                <span>{p.caution}</span>
                            </p>
                        )}
                    </div>
                </div>
            </section>
        ))}

        <!-- ==================== LE RITUEL D'UNE JOURNÉE ==================== -->
        <section class="ritual">
            <div class="ritual-head">
                <p class="inf-eyebrow">Le rituel</p>
                <h2 class="sec-title">Une journée BenDjo</h2>
                <p class="sec-lead">Les trois infusions ne se boivent pas au hasard : chacune a son moment.</p>
            </div>

            <ol class="ritual-steps">
                {ritual.map((r) => (
                    <li class={`step step-${r.id}`}>
                        <span class="step-time">{r.h}</span>
                        <h3 class="step-name">{r.name}</h3>
                        <p class="step-text">{r.text}</p>
                    </li>
                ))}
            </ol>
        </section>

        <!-- ==================== PACK DÉCOUVERTE ==================== -->
        <section class="pack">
            <div class="pack-inner">
                <div class="pack-text">
                    <p class="pack-eyebrow">Le trio complet</p>
                    <h2 class="pack-title">Prenez les trois</h2>
                    <p class="pack-lead">
                        Hibiscus le matin, citronnelle après le repas, basilic le soir.
                        Le trio couvre la journée entière — et c’est la meilleure façon
                        de trouver celle qui vous correspond.
                    </p>
                    <ul class="pack-list">
                        {products.map((p) => (
                            <li><i class={`dot dot-${p.id}`}></i>{p.name} <span>· {p.moment.toLowerCase()}</span></li>
                        ))}
                    </ul>
                    <div class="pack-buy">
                        <span class="pack-price">{formatFCFA(packPrice)} <small>FCFA</small></span>
                        <!-- ajoute les trois au panier ; sans JS, part sur WhatsApp -->
                        <a class="btn-pack" data-add-all href={`${WA}Bonjour%20BenDjo%2C%20je%20souhaite%20commander%20le%20trio%20complet%20(hibiscus%2C%20citronnelle%2C%20basilic).`} target="_blank" rel="noopener">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M12 5v14"></path></svg>
                            Ajouter le trio au panier
                        </a>
                    </div>
                </div>

                <div class="pack-media">
                    <img src="/images/bendjo/tray.webp" alt="Les trois infusions BenDjo" width="1100" height="1100" loading="lazy" />
                </div>
            </div>
        </section>

        <!-- ==================== À VENIR + RÉASSURANCE ==================== -->
        <section class="inf-foot">
            <div class="soon">
                <span class="soon-index">N°04</span>
                <p><b>Autres variétés</b> — feuille de laurier seule &amp; autres infusions du terroir, en préparation.</p>
                <span class="soon-badge">Bientôt</span>
            </div>

            <Reassurance variant="catalog" />

            <p class="inf-legal">
                Nos infusions sont des boissons de bien-être, pas des médicaments : elles
                ne remplacent ni un avis médical ni un traitement. En cas de grossesse,
                d’allaitement ou de traitement en cours, parlez-en à un professionnel de santé.
            </p>
        </section>
    </main>
</Layout>
