---
import { products, formatFCFA, WHATSAPP_BASE } from '../data/products';
---

<div class="cart-drawer" id="cart-drawer" aria-hidden="true">
    <div class="cart-backdrop" data-cart-close></div>

    <aside class="cart-panel" role="dialog" aria-modal="true" aria-labelledby="cart-title">
        <header class="cart-head">
            <div>
                <p class="cart-eyebrow">Votre commande</p>
                <h2 class="cart-title" id="cart-title">Panier</h2>
            </div>
            <button class="cart-close" type="button" data-cart-close aria-label="Fermer le panier">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"></path></svg>
            </button>
        </header>

        <div class="cart-list">
            {products.map((p) => (
                <article
                    class={`cart-item plant-${p.id}`}
                    data-item={p.id}
                    data-price={p.price}
                    data-name={p.name}
                >
                    <img src={p.photo} alt="" width="500" height="500" loading="lazy" />

                    <div class="cart-item-txt">
                        <p class="cart-item-name">{p.name}</p>
                        <p class="cart-item-sub">{p.moment} · {formatFCFA(p.price)} FCFA</p>
                    </div>

                    <div class="cart-qty">
                        <button type="button" data-step={p.id} data-delta="-1" aria-label={`Retirer une infusion ${p.name}`}>
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" aria-hidden="true"><path d="M5 12h14"></path></svg>
                        </button>
                        <span class="cart-qty-val" data-qty={p.id} aria-live="polite" aria-label={`Quantité ${p.name}`}>0</span>
                        <button type="button" data-step={p.id} data-delta="1" aria-label={`Ajouter une infusion ${p.name}`}>
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" aria-hidden="true"><path d="M5 12h14M12 5v14"></path></svg>
                        </button>
                    </div>
                </article>
            ))}
        </div>

        <footer class="cart-foot">
            <p class="cart-empty" data-cart-empty>
                Votre panier est vide. Ajoutez une infusion avec le bouton <b>+</b>.
            </p>

            <div class="cart-total">
                <span>Total</span>
                <strong data-cart-total>0 FCFA</strong>
            </div>

            <a class="cart-order is-disabled" data-cart-order href={WHATSAPP_BASE} target="_blank" rel="noopener" aria-disabled="true">
                <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.75.46 3.45 1.32 4.95L2 22l5.25-1.38a9.9 9.9 0 0 0 4.79 1.22h.01c5.46 0 9.9-4.45 9.9-9.91 0-2.65-1.03-5.14-2.9-7.01A9.82 9.82 0 0 0 12.04 2Zm0 18.15h-.01a8.2 8.2 0 0 1-4.18-1.14l-.3-.18-3.11.82.83-3.04-.2-.31a8.2 8.2 0 0 1-1.26-4.39c0-4.54 3.7-8.24 8.24-8.24 2.2 0 4.27.86 5.83 2.42a8.2 8.2 0 0 1 2.41 5.83c0 4.54-3.7 8.23-8.28 8.23Zm4.52-6.16c-.25-.12-1.47-.72-1.69-.81-.23-.08-.39-.12-.56.13-.16.25-.64.81-.79.97-.14.17-.29.19-.54.06-.25-.12-1.05-.39-1.99-1.23-.74-.66-1.23-1.47-1.38-1.72-.14-.25-.01-.38.11-.51.11-.11.25-.29.37-.43.12-.15.16-.25.25-.41.08-.17.04-.31-.02-.43-.06-.12-.56-1.34-.76-1.84-.2-.48-.4-.42-.56-.42-.14 0-.31-.02-.47-.02s-.43.06-.66.31c-.22.25-.86.85-.86 2.07 0 1.22.89 2.4 1.01 2.56.12.17 1.75 2.67 4.23 3.74.59.26 1.05.41 1.41.52.59.19 1.13.16 1.56.1.48-.07 1.47-.6 1.68-1.18.21-.58.21-1.07.14-1.18-.06-.11-.22-.17-.47-.29Z"></path></svg>
                Commander sur WhatsApp
            </a>

            <p class="cart-note">
                Le récapitulatif part pré-rempli dans la conversation. La livraison
                (dès 500 FCFA) est confirmée avec vous sur WhatsApp.
            </p>
        </footer>
    </aside>
</div>

<script>
    const KEY = 'bendjo-cart';
    const WA = 'https://wa.me/2290162014161?text=';

    const drawer = document.getElementById('cart-drawer');

    if (drawer) {
        const panel = drawer.querySelector('.cart-panel') as HTMLElement;
        const items = Array.from(drawer.querySelectorAll<HTMLElement>('[data-item]'));
        const totalEl = drawer.querySelector('[data-cart-total]') as HTMLElement;
        const emptyEl = drawer.querySelector('[data-cart-empty]') as HTMLElement;
        const orderEl = drawer.querySelector('[data-cart-order]') as HTMLAnchorElement;
        const closeBtn = drawer.querySelector('.cart-close') as HTMLButtonElement;

        const fmt = (n: number) =>
            String(n).replace(/\B(?=(\d{3})+(?!\d))/g, ' ') + ' FCFA';

        let cart: Record<string, number> = {};
        try {
            cart = JSON.parse(localStorage.getItem(KEY) || '{}') || {};
        } catch {
            cart = {};
        }

        const save = () => {
            try {
                localStorage.setItem(KEY, JSON.stringify(cart));
            } catch {
                /* navigation privée : le panier reste valable pour la session */
            }
        };

        function render() {
            let total = 0;
            let count = 0;
            const lines: string[] = [];

            items.forEach((el) => {
                const id = el.dataset.item as string;
                const price = Number(el.dataset.price);
                const qty = cart[id] || 0;

                (el.querySelector('[data-qty]') as HTMLElement).textContent = String(qty);
                el.classList.toggle('is-active', qty > 0);
                (el.querySelector('[data-delta="-1"]') as HTMLButtonElement).disabled = qty === 0;

                total += qty * price;
                count += qty;
                if (qty > 0) lines.push(`${qty} × ${el.dataset.name} — ${fmt(qty * price)}`);
            });

            document.querySelectorAll<HTMLElement>('.cart-count').forEach((n) => {
                n.textContent = String(count);
            });

            // Les liens WhatsApp directs (hero, menu mobile) n'ignorent jamais
            // un panier rempli : ils envoient le récapitulatif à la place du
            // message générique.
            const recap =
                WA +
                encodeURIComponent(
                    `Bonjour BenDjo, je souhaite commander :\n${lines.join('\n')}\n\nTotal : ${fmt(total)}`,
                );
            document.querySelectorAll<HTMLAnchorElement>('[data-wa-generic]').forEach((a) => {
                if (!a.dataset.waDefault) a.dataset.waDefault = a.href;
                a.href = count > 0 ? recap : a.dataset.waDefault;
            });

            totalEl.textContent = fmt(total);
            emptyEl.hidden = count > 0;
            orderEl.classList.toggle('is-disabled', count === 0);
            orderEl.setAttribute('aria-disabled', String(count === 0));
            orderEl.href = recap;
        }

        let lastFocus: HTMLElement | null = null;

        function open() {
            if (drawer.classList.contains('is-open')) return;
            lastFocus = document.activeElement as HTMLElement;
            drawer.classList.add('is-open');
            drawer.setAttribute('aria-hidden', 'false');
            document.body.classList.add('has-cart-open');
            closeBtn.focus();
        }

        function close() {
            drawer.classList.remove('is-open');
            drawer.setAttribute('aria-hidden', 'true');
            document.body.classList.remove('has-cart-open');
            lastFocus?.focus();
        }

        function bump(id: string, delta: number) {
            cart[id] = Math.max(0, (cart[id] || 0) + delta);
            if (cart[id] === 0) delete cart[id];
            save();
            render();
        }

        function addAll() {
            items.forEach((el) => {
                const id = el.dataset.item as string;
                cart[id] = (cart[id] || 0) + 1;
            });
            save();
            render();
        }

        // Icône panier + bouton « Commander » de la nav
        // (restent des liens vers le catalogue sans JS)
        document.querySelectorAll<HTMLAnchorElement>('.cart, [data-cart-open]').forEach((link) => {
            link.addEventListener('click', (e) => {
                e.preventDefault();
                open();
            });
        });

        // « Ajouter le trio au panier » (sans JS : lien WhatsApp de repli)
        document.querySelectorAll<HTMLAnchorElement>('[data-add-all]').forEach((link) => {
            link.addEventListener('click', (e) => {
                e.preventDefault();
                addAll();
                open();
            });
        });

        drawer.querySelectorAll('[data-cart-close]').forEach((el) =>
            el.addEventListener('click', close),
        );

        drawer.querySelectorAll<HTMLButtonElement>('[data-step]').forEach((btn) => {
            btn.addEventListener('click', () =>
                bump(btn.dataset.step as string, Number(btn.dataset.delta)),
            );
        });

        // « Ajouter au panier » : on ajoute puis on ouvre le tiroir sur la ligne concernée
        document.querySelectorAll<HTMLButtonElement>('[data-add]').forEach((btn) => {
            btn.addEventListener('click', () => {
                const id = btn.dataset.add as string;
                bump(id, 1);
                open();
                const row = drawer.querySelector(`[data-item="${id}"]`);
                if (row) {
                    row.classList.remove('just-added');
                    void (row as HTMLElement).offsetWidth; // relance l'animation
                    row.classList.add('just-added');
                }
            });
        });

        document.addEventListener('keydown', (e) => {
            if (e.key === 'Escape' && drawer.classList.contains('is-open')) close();
        });

        // Panier partagé entre les onglets ouverts
        window.addEventListener('storage', (e) => {
            if (e.key !== KEY) return;
            try {
                cart = JSON.parse(e.newValue || '{}') || {};
            } catch {
                cart = {};
            }
            render();
        });

        // Piège à focus : la tabulation reste dans le tiroir quand il est ouvert
        panel.addEventListener('keydown', (e) => {
            if (e.key !== 'Tab') return;
            const focusables = panel.querySelectorAll<HTMLElement>(
                'button:not([disabled]), a[href]',
            );
            if (!focusables.length) return;
            const first = focusables[0];
            const last = focusables[focusables.length - 1];
            if (e.shiftKey && document.activeElement === first) {
                e.preventDefault();
                last.focus();
            } else if (!e.shiftKey && document.activeElement === last) {
                e.preventDefault();
                first.focus();
            }
        });

        render();
    }
</script>
