---
import { products, formatFCFA } from '../data/products';
import { wa } from '../data/site';
import WhatsApp from './icons/WhatsApp.astro';

// Repli sans JavaScript : le tiroir n'est alors pas atteignable, mais le lien
// pointe vers une conversation valide plutôt qu'un message vide.
const WA_FALLBACK = wa('Bonjour BenDjo, je souhaite passer commande.');
---

<div class="cart-drawer" id="cart-drawer" aria-hidden="true">
    <div class="cart-backdrop" data-cart-close></div>

    <aside class="cart-panel" role="dialog" aria-modal="true" aria-labelledby="cart-title">
        <header class="cart-head">
            <div>
                <p class="cart-eyebrow">Votre commande</p>
                <h2 class="cart-title" id="cart-title">Panier</h2>
            </div>
            <button class="cart-close" type="button" data-cart-close aria-label="Fermer le panier">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"></path></svg>
            </button>
        </header>

        <div class="cart-list">
            {products.map((p) => (
                <article
                    class={`cart-item plant-${p.id}`}
                    data-item={p.id}
                    data-price={p.price}
                    data-name={p.name}
                >
                    <img src={p.photo} alt="" width="500" height="500" loading="lazy" />

                    <div class="cart-item-txt">
                        <p class="cart-item-name">{p.name}</p>
                        <p class="cart-item-sub">{p.moment} · {formatFCFA(p.price)} FCFA</p>
                    </div>

                    <div class="cart-qty">
                        <button type="button" data-step={p.id} data-delta="-1" aria-label={`Retirer une infusion ${p.name}`}>
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" aria-hidden="true"><path d="M5 12h14"></path></svg>
                        </button>
                        <span class="cart-qty-val" data-qty={p.id} aria-live="polite" aria-label={`Quantité ${p.name}`}>0</span>
                        <button type="button" data-step={p.id} data-delta="1" aria-label={`Ajouter une infusion ${p.name}`}>
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" aria-hidden="true"><path d="M5 12h14M12 5v14"></path></svg>
                        </button>
                    </div>
                </article>
            ))}
        </div>

        <footer class="cart-foot">
            <p class="cart-empty" data-cart-empty>
                Votre panier est vide. Ajoutez une infusion avec le bouton <b>+</b>.
            </p>

            <div class="cart-total">
                <span>Total</span>
                <strong data-cart-total>0 FCFA</strong>
            </div>

            <a
                class="cart-order is-disabled"
                data-cart-order
                data-fallback={WA_FALLBACK}
                href={WA_FALLBACK}
                target="_blank"
                rel="noopener"
                aria-disabled="true"
                tabindex="-1"
            >
                <WhatsApp />
                Commander sur WhatsApp
            </a>

            <p class="cart-note">
                Le récapitulatif part pré-rempli dans la conversation. La livraison
                (dès 500 FCFA) est confirmée avec vous sur WhatsApp.
            </p>
        </footer>
    </aside>
</div>

<script>
    // Les <script> d'Astro sont bundlés par Vite : ils peuvent importer les
    // mêmes modules que le frontmatter. Plus de numéro ni de formateur recopiés.
    // On vise data/core directement : passer par site.ts ou products.ts
    // embarquerait le catalogue et les tracés SVG dans le bundle client.
    import { WA_NUMBER, formatFCFA } from '../data/core';

    const KEY = 'bendjo-cart';
    const WA = `https://wa.me/${WA_NUMBER}?text=`;

    const drawer = document.getElementById('cart-drawer');

    const panel = drawer?.querySelector<HTMLElement>('.cart-panel');
    const totalEl = drawer?.querySelector<HTMLElement>('[data-cart-total]');
    const emptyEl = drawer?.querySelector<HTMLElement>('[data-cart-empty]');
    const orderEl = drawer?.querySelector<HTMLAnchorElement>('[data-cart-order]');
    const closeBtn = drawer?.querySelector<HTMLButtonElement>('.cart-close');

    // Une garde plutôt que des « as » : si le balisage change de classe, le
    // panier s'arrête proprement au lieu de lever un TypeError au premier rendu
    // — ce qui interromprait le script et figerait le compteur de la nav.
    if (drawer && panel && totalEl && emptyEl && orderEl && closeBtn) {
        const items = Array.from(drawer.querySelectorAll<HTMLElement>('[data-item]'));
        const connus = new Set(items.map((el) => el.dataset.item));

        const fmt = (n: number) => `${formatFCFA(n)} FCFA`;

        const lire = (brut: string | null): Record<string, number> => {
            try {
                const objet = JSON.parse(brut || '{}');
                if (!objet || typeof objet !== 'object') return {};
                // On ne garde que les produits encore au catalogue, en quantité
                // valide : une entrée orpheline resterait sinon indéfiniment
                // dans le navigateur du visiteur.
                return Object.fromEntries(
                    Object.entries(objet as Record<string, unknown>)
                        .map(([id, n]) => [id, Math.max(0, Math.floor(Number(n) || 0))] as const)
                        .filter(([id, n]) => connus.has(id) && n > 0),
                );
            } catch {
                return {};
            }
        };

        let cart = lire(localStorage.getItem(KEY));

        const save = () => {
            try {
                localStorage.setItem(KEY, JSON.stringify(cart));
            } catch {
                /* navigation privée : le panier reste valable pour la session */
            }
        };

        function render() {
            let total = 0;
            let count = 0;
            const lines: string[] = [];

            items.forEach((el) => {
                const id = el.dataset.item ?? '';
                const price = Number(el.dataset.price);
                const qty = cart[id] || 0;

                const val = el.querySelector<HTMLElement>('[data-qty]');
                const moins = el.querySelector<HTMLButtonElement>('[data-delta="-1"]');
                if (val) val.textContent = String(qty);
                if (moins) moins.disabled = qty === 0;
                el.classList.toggle('is-active', qty > 0);

                total += qty * price;
                count += qty;
                if (qty > 0) lines.push(`${qty} × ${el.dataset.name} — ${fmt(qty * price)}`);
            });

            document.querySelectorAll<HTMLElement>('.cart-count').forEach((n) => {
                n.textContent = String(count);
            });

            // Les liens WhatsApp directs (hero, menu mobile) n'ignorent jamais
            // un panier rempli : ils envoient le récapitulatif à la place du
            // message générique.
            const recap =
                WA +
                encodeURIComponent(
                    `Bonjour BenDjo, je souhaite commander :\n${lines.join('\n')}\n\nTotal : ${fmt(total)}`,
                );
            document.querySelectorAll<HTMLAnchorElement>('[data-wa-generic]').forEach((a) => {
                if (!a.dataset.waDefault) a.dataset.waDefault = a.href;
                a.href = count > 0 ? recap : a.dataset.waDefault;
            });

            totalEl.textContent = fmt(total);
            emptyEl.hidden = count > 0;

            // Panier vide : le CSS ne pose que pointer-events:none, qui bloque
            // la souris mais pas Tab + Entrée — un panier vide partait alors sur
            // WhatsApp avec « je souhaite commander : / Total : 0 FCFA ».
            // On sort donc le lien de la tabulation et on garde une garde au
            // clic. Mais on lui laisse toujours un href : un <a> sans href est
            // compté comme lien non explorable par les robots.
            const empty = count === 0;
            orderEl.classList.toggle('is-disabled', empty);
            orderEl.setAttribute('aria-disabled', String(empty));
            orderEl.tabIndex = empty ? -1 : 0;
            orderEl.href = empty ? (orderEl.dataset.fallback ?? recap) : recap;
        }

        let lastFocus: HTMLElement | null = null;

        // Le reste de la page est neutralisé pendant que le tiroir est ouvert :
        // le piège à focus retient déjà la tabulation, mais sans « inert » un
        // lecteur d'écran en parcours libre continuait de lire l'arrière-plan.
        const arrierePlan = () =>
            document.querySelectorAll<HTMLElement>('body > *:not(.cart-drawer)');

        function open() {
            if (drawer.classList.contains('is-open')) return;
            lastFocus =
                document.activeElement instanceof HTMLElement ? document.activeElement : null;
            drawer.classList.add('is-open');
            drawer.setAttribute('aria-hidden', 'false');
            document.body.classList.add('has-cart-open');
            arrierePlan().forEach((el) => el.setAttribute('inert', ''));
            closeBtn.focus();
        }

        function close() {
            drawer.classList.remove('is-open');
            drawer.setAttribute('aria-hidden', 'true');
            document.body.classList.remove('has-cart-open');
            arrierePlan().forEach((el) => el.removeAttribute('inert'));
            lastFocus?.focus();
        }

        function bump(id: string, delta: number) {
            const n = Math.max(0, (cart[id] || 0) + delta);
            if (n === 0) delete cart[id];
            else cart[id] = n;
            save();
            render();
        }

        function addAll() {
            items.forEach((el) => {
                const id = el.dataset.item;
                if (id) cart[id] = (cart[id] || 0) + 1;
            });
            save();
            render();
        }

        // Icône panier + bouton « Commander » de la nav
        // (restent des liens vers le catalogue sans JS)
        document.querySelectorAll<HTMLAnchorElement>('.cart, [data-cart-open]').forEach((link) => {
            link.addEventListener('click', (e) => {
                e.preventDefault();
                open();
            });
        });

        // « Ajouter le trio au panier » (sans JS : lien WhatsApp de repli)
        document.querySelectorAll<HTMLAnchorElement>('[data-add-all]').forEach((link) => {
            link.addEventListener('click', (e) => {
                e.preventDefault();
                addAll();
                open();
            });
        });

        // Ceinture et bretelles : le lien garde un href pour rester explorable,
        // donc on bloque explicitement son activation quand le panier est vide.
        orderEl.addEventListener('click', (e) => {
            if (orderEl.getAttribute('aria-disabled') === 'true') e.preventDefault();
        });

        drawer.querySelectorAll('[data-cart-close]').forEach((el) =>
            el.addEventListener('click', close),
        );

        drawer.querySelectorAll<HTMLButtonElement>('[data-step]').forEach((btn) => {
            btn.addEventListener('click', () => {
                if (btn.dataset.step) bump(btn.dataset.step, Number(btn.dataset.delta));
            });
        });

        // « Ajouter au panier » : on ajoute puis on ouvre le tiroir sur la ligne concernée
        document.querySelectorAll<HTMLButtonElement>('[data-add]').forEach((btn) => {
            btn.addEventListener('click', () => {
                const id = btn.dataset.add;
                if (!id) return;
                bump(id, 1);
                open();
                const row = drawer.querySelector<HTMLElement>(`[data-item="${id}"]`);
                if (row) {
                    row.classList.remove('just-added');
                    void row.offsetWidth; // relance l'animation
                    row.classList.add('just-added');
                }
            });
        });

        document.addEventListener('keydown', (e) => {
            if (e.key === 'Escape' && drawer.classList.contains('is-open')) close();
        });

        // Panier partagé entre les onglets ouverts
        window.addEventListener('storage', (e) => {
            if (e.key !== KEY) return;
            cart = lire(e.newValue);
            render();
        });

        // Piège à focus : la tabulation reste dans le tiroir quand il est ouvert
        panel.addEventListener('keydown', (e) => {
            if (e.key !== 'Tab') return;
            const focusables = panel.querySelectorAll<HTMLElement>(
                'button:not([disabled]), a[href]',
            );
            if (!focusables.length) return;
            const first = focusables[0];
            const last = focusables[focusables.length - 1];
            if (e.shiftKey && document.activeElement === first) {
                e.preventDefault();
                last.focus();
            } else if (!e.shiftKey && document.activeElement === last) {
                e.preventDefault();
                first.focus();
            }
        });

        render();
    }
</script>
