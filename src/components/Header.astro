---
import { NAV, PHONE_DISPLAY, PHONE_TEL, EMAIL, wa } from '../data/site';

const WHATSAPP = wa('Bonjour BenDjo, je souhaite commander vos infusions.');

// Page courante : sert à colorer le lien actif, desktop comme mobile.
const path = Astro.url.pathname.replace(/\/+$/, '') || '/';
const isActive = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
---

<header class="header">
    <!-- C'est cette case qui porte le contrôle du menu : elle est focusable et
         s'active à la barre d'espace. Les deux <label> ci-dessous ne sont que
         sa représentation visuelle, d'où leur aria-hidden. -->
    <input type="checkbox" id="nav-toggle" class="nav-toggle" aria-label="Menu" />

    <a href="/" class="logo" aria-label="BenDjo">
        <img class="mark-img" src="/images/bendjo/logo-mark.webp" alt="BenDjo" width="130" height="285" />
        <span class="wordmark">Ben<span class="djo">Djo</span></span>
    </a>

    <nav class="nav-wrap">
        <label for="nav-toggle" class="nav-close" aria-hidden="true"><span></span><span></span></label>
        <ul class="nav">
            {NAV.map((item) => (
                <li>
                    <a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>
                        <span class="num">{item.num}</span><span class="lbl">{item.label}</span>
                    </a>
                </li>
            ))}
        </ul>
        <div class="nav-foot">
            <a href={WHATSAPP} target="_blank" rel="noopener" class="nav-foot-cta" data-wa-generic>Commander sur WhatsApp</a>
            <div class="nav-contact">
                <a href={`tel:${PHONE_TEL}`}>{PHONE_DISPLAY}</a>
                <a href={`mailto:${EMAIL}`}>{EMAIL}</a>
            </div>
        </div>
    </nav>

    <div class="actions">
        <a href="/nos-infusions" class="cart" aria-label="Panier">
            <svg width="21" height="21" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="8" cy="21" r="1"></circle><circle cx="19" cy="21" r="1"></circle><path d="M2.05 2.05h2l2.66 12.42a2 2 0 0 0 2 1.58h9.78a2 2 0 0 0 1.95-1.57l1.65-7.43H5.12"></path></svg>
            <span class="cart-count">0</span>
        </a>
        <!-- ouvre le panier ; sans JS, reste un lien vers le catalogue -->
        <a href="/nos-infusions" class="btn-nav-cta desktop-cta" data-cart-open>Commander</a>
        <label for="nav-toggle" class="burger" aria-hidden="true"><span></span><span></span><span></span></label>
    </div>
</header>

<script>
    // Amélioration progressive : sans JS, le menu s'ouvre et se ferme déjà à la
    // souris (label) comme au clavier (case à cocher). Ce script ajoute ce que
    // le CSS seul ne peut pas faire — fermer avec Échap, et empêcher la
    // tabulation d'atteindre le logo et le panier passés sous le calque.
    const brut = document.getElementById('nav-toggle');
    const toggle = brut instanceof HTMLInputElement ? brut : null;
    const header = document.querySelector<HTMLElement>('.header');

    if (toggle && header) {
        const behind = [
            header.querySelector<HTMLElement>('.logo'),
            header.querySelector<HTMLElement>('.actions'),
        ].filter((el): el is HTMLElement => el !== null);

        // Même palier que le CSS : au-delà, le calque n'existe plus et rien ne
        // doit être neutralisé (cas du redimensionnement menu ouvert).
        const mobile = window.matchMedia('(max-width: 1000px)');

        const sync = () => {
            const covered = toggle.checked && mobile.matches;
            behind.forEach((el) => el.toggleAttribute('inert', covered));
        };

        toggle.addEventListener('change', sync);
        mobile.addEventListener('change', sync);

        document.addEventListener('keydown', (e) => {
            if (e.key === 'Escape' && toggle.checked) {
                toggle.checked = false;
                sync();
                toggle.focus();
            }
        });

        // Le menu se referme quand on suit un lien vers une ancre de la page
        // courante : sans cela, le calque resterait ouvert par-dessus la cible.
        header.querySelectorAll('.nav a, .nav-foot a').forEach((a) =>
            a.addEventListener('click', () => {
                toggle.checked = false;
                sync();
            }),
        );

        sync();
    }
</script>
