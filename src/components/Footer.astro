---
import {
    NAV,
    ACTIVE_SOCIALS,
    PHONE_DISPLAY,
    PHONE_TEL,
    EMAIL,
    CITY,
    wa,
} from '../data/site';
import { products, formatFCFA } from '../data/products';

const WHATSAPP = wa('Bonjour BenDjo, je souhaite commander vos infusions.');
const year = new Date().getFullYear();
---

<footer class="ft">
    <div class="ft-top">
        <div class="ft-brand">
            <a href="/" class="ft-logo" aria-label="BenDjo">
                <img src="/images/bendjo/logo-mark.webp" alt="" width="130" height="285" loading="lazy" />
                <span>Ben<span class="djo">Djo</span></span>
            </a>
            <p class="ft-claim">La marque qui vous reconnecte à vos origines.</p>
            <p class="ft-desc">
                Infusions naturelles du terroir béninois, petit-déjeuner en entreprise
                et service traiteur. Basée à {CITY.replace(', Bénin', '')}, depuis 2025.
            </p>

            {ACTIVE_SOCIALS.length > 0 && (
                <ul class="ft-socials">
                    {ACTIVE_SOCIALS.map((s) => (
                        <li>
                            <a href={s.href} target="_blank" rel="noopener" aria-label={s.label}>
                                <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d={s.icon}></path></svg>
                            </a>
                        </li>
                    ))}
                </ul>
            )}
        </div>

        <nav class="ft-cols" aria-label="Pied de page">
            <div class="ft-col">
                <h2>Navigation</h2>
                <ul>
                    {NAV.map((item) => (
                        <li><a href={item.href}>{item.label}</a></li>
                    ))}
                </ul>
            </div>

            <div class="ft-col">
                <h2>Nos infusions</h2>
                <ul>
                    {products.map((p) => (
                        <li>
                            <a href={`/nos-infusions#${p.id}`}>
                                <i class={`ft-dot dot-${p.id}`} aria-hidden="true"></i>
                                {p.name}
                                <span>{formatFCFA(p.price)} FCFA</span>
                            </a>
                        </li>
                    ))}
                    <li><a href="/nos-infusions">Voir le catalogue</a></li>
                </ul>
            </div>

            <div class="ft-col ft-col-contact">
                <h2>Nous joindre</h2>
                <ul>
                    <li><a href={`tel:${PHONE_TEL}`}>{PHONE_DISPLAY}</a></li>
                    <li><a href={`mailto:${EMAIL}`}>{EMAIL}</a></li>
                    <li><span class="ft-plain">{CITY}</span></li>
                    <li><span class="ft-plain">Livraison à Cotonou &amp; Abomey-Calavi</span></li>
                </ul>
                <a class="ft-cta" href={WHATSAPP} target="_blank" rel="noopener" data-wa-generic>
                    <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.75.46 3.45 1.32 4.95L2 22l5.25-1.38a9.9 9.9 0 0 0 4.79 1.22h.01c5.46 0 9.9-4.45 9.9-9.91 0-2.65-1.03-5.14-2.9-7.01A9.82 9.82 0 0 0 12.04 2Zm0 18.15h-.01a8.2 8.2 0 0 1-4.18-1.14l-.3-.18-3.11.82.83-3.04-.2-.31a8.2 8.2 0 0 1-1.26-4.39c0-4.54 3.7-8.24 8.24-8.24 2.2 0 4.27.86 5.83 2.42a8.2 8.2 0 0 1 2.41 5.83c0 4.54-3.7 8.23-8.28 8.23Zm4.52-6.16c-.25-.12-1.47-.72-1.69-.81-.23-.08-.39-.12-.56.13-.16.25-.64.81-.79.97-.14.17-.29.19-.54.06-.25-.12-1.05-.39-1.99-1.23-.74-.66-1.23-1.47-1.38-1.72-.14-.25-.01-.38.11-.51.11-.11.25-.29.37-.43.12-.15.16-.25.25-.41.08-.17.04-.31-.02-.43-.06-.12-.56-1.34-.76-1.84-.2-.48-.4-.42-.56-.42-.14 0-.31-.02-.47-.02s-.43.06-.66.31c-.22.25-.86.85-.86 2.07 0 1.22.89 2.4 1.01 2.56.12.17 1.75 2.67 4.23 3.74.59.26 1.05.41 1.41.52.59.19 1.13.16 1.56.1.48-.07 1.47-.6 1.68-1.18.21-.58.21-1.07.14-1.18-.06-.11-.22-.17-.47-.29Z"></path></svg>
                    Écrire sur WhatsApp
                </a>
            </div>
        </nav>
    </div>

    <div class="ft-bottom">
        <p>© {year} BenDjo — Tous droits réservés.</p>
        <p class="ft-legal">
            Nos infusions sont des boissons de bien-être, pas des médicaments.
        </p>
    </div>
</footer>
